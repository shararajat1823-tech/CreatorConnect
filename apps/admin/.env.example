# CreatorConnect — admin (React/Vite) environment
# These values are PUBLIC (safe in the browser). Admin powers come from the
# signed-in user's admin role enforced by Row Level Security, not from secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the public marketplace URL, used to link to live profiles.
VITE_MARKETPLACE_URL=http://localhost:4200
