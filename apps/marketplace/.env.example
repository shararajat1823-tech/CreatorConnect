# CreatorConnect — marketplace (Angular) environment
# Copy to `.env` and fill in. These values are PUBLIC (safe in the browser):
# the anon key is designed to be exposed and is protected by Row Level Security.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
PUBLIC_SUPABASE_URL=

# Your Supabase "anon" public API key (Project Settings → API).
PUBLIC_SUPABASE_ANON_KEY=

# The public URL the marketplace is served from (used for canonical URLs,
# social preview metadata and the sitemap). No trailing slash.
PUBLIC_SITE_URL=http://localhost:4200
